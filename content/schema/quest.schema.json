{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emberwatch.local/schema/quest.schema.json",
    "title": "Quest definitions",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "localisationKey", "requiredLevel", "durationSeconds", "monsters", "rewards"],
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^quest\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
            },
            "localisationKey": {
                "type": "string",
                "minLength": 1
            },
            "requiredLevel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60
            },
            "durationSeconds": {
                "comment": "An accepted quest cannot be claimed before this much time has passed. See docs/adr/0008-quest-snapshot-resolution.md.",
                "type": "integer",
                "minimum": 30
            },
            "monsters": {
                "comment": "The opposing side of the one simulated fight this quest resolves into at claim time.",
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": { "type": "string", "pattern": "^monster\\.[a-z][a-z0-9_]*$" }
            },
            "rewards": {
                "comment": "Fixed per quest, not formula-derived. See docs/economy.md section 2.",
                "type": "object",
                "additionalProperties": false,
                "required": ["xp", "gold"],
                "properties": {
                    "xp": { "type": "integer", "minimum": 0 },
                    "gold": { "type": "integer", "minimum": 0 },
                    "materials": {
                        "type": "object",
                        "minProperties": 1,
                        "additionalProperties": { "type": "integer", "minimum": 1 },
                        "propertyNames": { "pattern": "^material\\.[a-z][a-z0-9_]*$" }
                    }
                }
            }
        }
    }
}
