{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emberwatch.local/schema/droptable.schema.json",
    "title": "Drop table definitions",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rolls", "entries"],
        "properties": {
            "id": { "type": "string", "pattern": "^droptable\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
            "rolls": { "type": "integer", "minimum": 1, "maximum": 10 },
            "entries": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["weight", "type"],
                    "properties": {
                        "weight": { "type": "integer", "minimum": 1, "maximum": 100000 },
                        "type": { "enum": ["nothing", "material", "item"] },
                        "materialId": { "type": "string", "pattern": "^material\\.[a-z][a-z0-9_]*$" },
                        "quantity": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": { "type": "integer", "minimum": 1 }
                        },
                        "pool": { "type": "string", "pattern": "^pool\\.[a-z][a-z0-9_]*$" },
                        "ilvlRange": {
                            "type": "array",
                            "minItems": 2,
                            "maxItems": 2,
                            "items": { "type": "integer", "minimum": 1, "maximum": 60 }
                        }
                    },
                    "allOf": [
                        {
                            "if": {
                                "properties": { "type": { "const": "material" } },
                                "required": ["type"]
                            },
                            "then": { "required": ["materialId", "quantity"] }
                        },
                        {
                            "if": {
                                "properties": { "type": { "const": "item" } },
                                "required": ["type"]
                            },
                            "then": { "required": ["pool", "ilvlRange"] }
                        }
                    ]
                }
            }
        }
    }
}
