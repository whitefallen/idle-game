{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emberwatch.local/schema/test/widget.schema.json",
    "title": "Test fixture schema",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "size"],
        "properties": {
            "id": { "type": "string", "pattern": "^widget\\.[a-z][a-z0-9_]*$" },
            "size": { "type": "integer", "minimum": 1, "maximum": 10 }
        }
    }
}
