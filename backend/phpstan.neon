includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon

parameters:
    level: 8

    # Defaults to the system temp dir, which does not survive between CI
    # containers and throws the result cache away on every run. Pointed here
    # instead — inside the bind mount, not var/ (a separate, non-bind-mounted
    # volume in compose.yaml) — so CI can cache it across runs the same way
    # it caches the Docker image layers.
    tmpDir: .phpstan-cache

    paths:
        - src
        - tests
        - bin

    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    treatPhpDocTypesAsCertain: false
