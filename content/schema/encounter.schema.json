{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emberwatch.local/schema/encounter.schema.json",
    "title": "Encounter definitions",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "localisationKey", "level", "tier", "vigorCost", "requiredLevel", "monsters", "dropTable"],
        "properties": {
            "id": { "type": "string", "pattern": "^encounter\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
            "localisationKey": { "type": "string", "minLength": 1 },
            "level": { "type": "integer", "minimum": 1, "maximum": 60 },
            "tier": { "enum": ["patrol", "elite", "boss"] },
            "vigorCost": { "type": "integer", "minimum": 1, "maximum": 120 },
            "requiredLevel": { "type": "integer", "minimum": 1, "maximum": 60 },
            "monsters": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "items": { "type": "string", "pattern": "^monster\\.[a-z][a-z0-9_]*$" }
            },
            "dropTable": { "type": "string", "pattern": "^droptable\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" }
        }
    }
}
