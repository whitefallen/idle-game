# The edge. Caddy is the only container that binds a public port.
#
# Plain HTTP for now, deliberately: TLS is deferred until the production
# rollout formally adds it (tracked alongside the initial deploy). auto_https
# off stops Caddy attempting any ACME challenge, and the explicit http://
# scheme keeps it listening on the HTTP port rather than defaulting to 443.
# To turn TLS back on: drop `auto_https off`, restore `email {$ACME_EMAIL}`,
# drop the `http://` prefix below, and restore the HSTS header — only once the
# domain is confirmed serving valid certificates, per the original comment
# this replaced.

{
	auto_https off

	# Health of the origin is nginx's to report; Caddy should not cache a
	# failing upstream decision across a deployment.
	servers {
		trusted_proxies static private_ranges
	}
}

http://{$EMBERWATCH_DOMAIN} {
	encode zstd gzip

	# The API sets session cookies and returns player state; no shared cache
	# between players may ever hold it.
	header /api/* Cache-Control "no-store"

	reverse_proxy web:80 {
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}
}
