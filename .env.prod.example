# Template for the production host's /opt/emberwatch/.env.
#
# Copy this to the server once, fill it in, and never commit the filled copy —
# it holds the database password and the application secret. The deploy
# workflow reads this file and appends PHP_IMAGE and WEB_IMAGE to it; nothing
# else in it is ever written automatically.
#
# chmod 600. See docs/deployment.md.

# The hostname players reach the game on. Its DNS A/AAAA record must already
# point at this server before the first deploy: Caddy requests a certificate on
# startup, and a failed challenge counts against Let's Encrypt's rate limit.
EMBERWATCH_DOMAIN=play.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=ops@example.com

# Postgres superuser password for the emberwatch role. Generate with
# `openssl rand -base64 32`. Changing it later requires an ALTER ROLE against
# the running database, not just an edit here — the volume keeps the old one.
POSTGRES_PASSWORD=

# Symfony's APP_SECRET. Generate with `openssl rand -hex 32`. Rotating it
# invalidates every signed cookie, so players are signed out on the next
# deployment.
APP_SECRET=

# Edge ports. Leave at the defaults to let Caddy own :80 and :443 and manage
# certificates itself. If another container on this host already binds them,
# move these to free ports and have that proxy terminate TLS and forward here.
#CADDY_HTTP_PORT=80
#CADDY_HTTPS_PORT=443

# Written by the deploy workflow. Present here only so the file documents its
# own full contents; do not set them by hand except to force a rollback.
#PHP_IMAGE=
#WEB_IMAGE=
