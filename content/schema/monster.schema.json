{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emberwatch.local/schema/monster.schema.json",
    "title": "Monster definitions",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
            "id",
            "localisationKey",
            "level",
            "maxHealth",
            "initiative",
            "maxFocus",
            "focusPerTurn",
            "weaponBaseDamage",
            "abilities",
            "battlePlan"
        ],
        "properties": {
            "id": { "type": "string", "pattern": "^monster\\.[a-z][a-z0-9_]*$" },
            "localisationKey": { "type": "string", "minLength": 1 },
            "level": { "type": "integer", "minimum": 1, "maximum": 60 },
            "maxHealth": { "type": "integer", "minimum": 1 },
            "initiative": { "type": "integer", "minimum": 0 },
            "maxFocus": { "type": "integer", "minimum": 0 },
            "focusPerTurn": { "type": "integer", "minimum": 0 },
            "weaponBaseDamage": { "type": "integer", "minimum": 0 },
            "flatDamageBonus": { "type": "integer", "minimum": 0 },
            "scalingBp": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "critChanceBp": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "critPowerBp": { "type": "integer", "minimum": 10000, "maximum": 50000 },
            "dodgeChanceBp": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "accuracyBp": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "armourRating": { "type": "integer", "minimum": 0 },
            "resistanceRatings": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "physical": { "type": "integer", "minimum": 0 },
                    "arcane": { "type": "integer", "minimum": 0 },
                    "nature": { "type": "integer", "minimum": 0 }
                }
            },
            "abilities": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^ability\\.[a-z][a-z0-9_]*$" }
            },
            "battlePlan": { "$ref": "#/$defs/battlePlan" }
        }
    },
    "$defs": {
        "battlePlan": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["condition", "ability"],
                "properties": {
                    "ability": { "type": "string", "pattern": "^ability\\.[a-z][a-z0-9_]*$" },
                    "condition": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 3,
                        "items": { "$ref": "#/$defs/conditionTerm" }
                    }
                }
            }
        },
        "conditionTerm": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject"],
            "properties": {
                "subject": {
                    "enum": [
                        "always",
                        "self.health_percent",
                        "self.focus",
                        "enemy.count",
                        "target.health_percent",
                        "round",
                        "self.has_effect",
                        "target.has_effect"
                    ]
                },
                "operator": { "enum": ["lt", "lte", "gt", "gte", "eq"] },
                "value": { "type": "integer", "minimum": 0, "maximum": 100000 },
                "effectId": { "type": "string", "pattern": "^effect\\.[a-z][a-z0-9_]*$" }
            },
            "allOf": [
                {
                    "comment": "Numeric subjects need an operator and a value.",
                    "if": {
                        "properties": {
                            "subject": {
                                "enum": [
                                    "self.health_percent",
                                    "self.focus",
                                    "enemy.count",
                                    "target.health_percent",
                                    "round"
                                ]
                            }
                        },
                        "required": ["subject"]
                    },
                    "then": { "required": ["operator", "value"] }
                },
                {
                    "comment": "Presence subjects need an effect id and nothing else.",
                    "if": {
                        "properties": {
                            "subject": { "enum": ["self.has_effect", "target.has_effect"] }
                        },
                        "required": ["subject"]
                    },
                    "then": {
                        "required": ["effectId"],
                        "not": {
                            "anyOf": [
                                { "required": ["operator"] },
                                { "required": ["value"] }
                            ]
                        }
                    }
                },
                {
                    "comment": "The unconditional subject takes no arguments.",
                    "if": {
                        "properties": { "subject": { "const": "always" } },
                        "required": ["subject"]
                    },
                    "then": {
                        "not": {
                            "anyOf": [
                                { "required": ["operator"] },
                                { "required": ["value"] },
                                { "required": ["effectId"] }
                            ]
                        }
                    }
                }
            ]
        }
    }
}
