# The TLS edge. Caddy is the only container that binds a public port.
#
# Certificates are obtained and renewed automatically from Let's Encrypt and
# stored in the caddy-data volume. That volume is the one piece of edge state
# worth keeping: losing it means re-issuing certificates on the next start,
# which the rate limits punish if it happens repeatedly.

{
	email {$ACME_EMAIL}

	# Health of the origin is nginx's to report; Caddy should not cache a
	# failing upstream decision across a deployment.
	servers {
		trusted_proxies static private_ranges
	}
}

{$EMBERWATCH_DOMAIN} {
	encode zstd gzip

	# HSTS. Only meaningful once the domain is confirmed working over TLS —
	# a browser that has seen this header will refuse plain HTTP for a year.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# The API sets session cookies and returns player state; no shared cache
	# between players may ever hold it.
	header /api/* Cache-Control "no-store"

	reverse_proxy web:80 {
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}
}
