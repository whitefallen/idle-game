{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://emberwatch.local/schema/effect.schema.json",
    "title": "Effect definitions",
    "type": "array",
    "minItems": 1,
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "localisationKey", "kind", "magnitude", "durationRounds"],
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^effect\\.[a-z][a-z0-9_]*$"
            },
            "localisationKey": {
                "type": "string",
                "minLength": 1
            },
            "kind": {
                "enum": ["damage_over_time", "heal_over_time", "damage_modifier"]
            },
            "magnitude": {
                "type": "integer",
                "minimum": -10000,
                "maximum": 100000
            },
            "durationRounds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
            },
            "school": {
                "enum": ["physical", "arcane", "nature"]
            }
        },
        "allOf": [
            {
                "comment": "Only damage_modifier may reduce; ticking effects must be non-negative.",
                "if": {
                    "properties": {
                        "kind": { "enum": ["damage_over_time", "heal_over_time"] }
                    },
                    "required": ["kind"]
                },
                "then": {
                    "properties": {
                        "magnitude": { "minimum": 1 }
                    }
                }
            }
        ]
    }
}
